; NEEDLE+ — симулятор поиска иголки в стоге сена (Godot 4.7, target: Android)
config_version=5

[application]
config/name="NEEDLE+"
config/description="Найди иголку в стоге сена — копай, продавай сено, строй фабрику."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
Game="*res://scripts/game.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_touch_from_mouse=true

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=14.0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
